# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. NEVER commit real values.
#
# This project is READ-ONLY and NON-CUSTODIAL:
# it never needs, asks for, or stores a private key or seed phrase.
# If any tool or person asks you to put one here, STOP.

# ---- Mode ----
# "demo" = simulated data, no wallet / RPC / keys needed (the public demo uses this).
# "live" = reads real Aave V3 positions through RPC.
APP_MODE=demo

# ---- RPC endpoints (optional; public RPCs are used if empty) ----
# Free tiers work (e.g. Alchemy). Paste the full HTTPS URL.
RPC_URL_ETHEREUM=
RPC_URL_ARBITRUM=
RPC_URL_BASE=
RPC_URL_POLYGON=

# ---- Telegram bot (Phase 4) ----
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ---- Database (Phase 4) ----
# SQLite file for development, or a postgres:// URL for hosting.
DATABASE_URL=file:./data/guardian.db

# ---- Dashboard API (Phase 5) ----
# Local default: 127.0.0.1:4000. Hosts like Render set PORT themselves (then it listens on 0.0.0.0).
API_PORT=4000

# ---- Dashboard login (LIVE mode only; demo mode is public and read-only) ----
# Store only a HASH, never the plain password. Generate it with:  npm run hash:password
ADMIN_PASSWORD_HASH=
# A long random string that signs login sessions. Generate it with:  npm run session:secret
# Changing it logs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string
# Send the login cookie only over HTTPS. Set to true when hosted (default: true if NODE_ENV=production).
# COOKIE_SECURE=true
# Set to true only behind a trusted reverse proxy, so per-IP rate limits see the real client IP.
TRUST_PROXY=false
