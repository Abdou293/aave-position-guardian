{
  "name": "aave-position-guardian",
  "version": "0.1.0",
  "description": "Read-only, non-custodial early-warning monitor for Aave V3 borrowers (health factor alerts via Telegram + dashboard). Portfolio project.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "node scripts/enable-git-hooks.mjs",
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:addresses": "tsx --env-file-if-exists=.env scripts/verify-addresses.ts",
    "scan:secrets": "node scripts/scan-folder.mjs",
    "scan:history": "gitleaks git . --config .gitleaks.toml --redact --no-banner",
    "scan:all": "npm run scan:secrets && npm run scan:history",
    "read:position": "tsx --env-file-if-exists=.env scripts/read-position.ts",
    "hash:password": "tsx scripts/hash-password.ts",
    "session:secret": "node -e \"console.log('SESSION_SECRET='+require('crypto').randomBytes(48).toString('base64url'))\"",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "fork:validate": "tsx --env-file-if-exists=.env scripts/fork-validate.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.3.0",
    "fastify": "^5.12.8",
    "grammy": "^1.48.0",
    "pg": "^8.23.1",
    "viem": "^2.58.7"
  },
  "devDependencies": {
    "@bgd-labs/aave-address-book": "^4.44.22",
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
